# HOMIQ — Smart Property CRM (SaaS Platform)
# Environment Variables Configuration

# ----------------------------------------------------
# NEXT.JS APPLICATION CONFIGURATION
# ----------------------------------------------------
NEXT_PUBLIC_APP_NAME="HOMIQ — Smart Property CRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_TENANT_ID="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
NEXT_PUBLIC_WORKSPACE_NAME="Garut Sejahtera Property"

# ----------------------------------------------------
# SUPABASE BACKEND (PostgreSQL + Auth + Realtime + Storage)
# Dapatkan kredensial ini di dashboard Supabase -> Project Settings -> API
# ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# SUPABASE SERVICE ROLE (Hanya untuk server-side administrative API / bypass RLS)
# PERINGATAN: Jangan pernah mengekspos kunci ini ke browser client (tanpa prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# ----------------------------------------------------
# DEMO MODE SETTINGS
# ----------------------------------------------------
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
